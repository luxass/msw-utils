{
  "name": "@luxass/msw-utils",
  "version": "0.6.1",
  "description": "Utilities for working with MSW",
  "type": "module",
  "author": {
    "name": "Lucas Nørgård",
    "email": "lucasnrgaard@gmail.com",
    "url": "https://luxass.dev"
  },
  "packageManager": "pnpm@10.33.0",
  "license": "MIT",
  "homepage": "https://github.com/luxass/msw-utils#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luxass/msw-utils.git"
  },
  "bugs": "https://github.com/luxass/msw-utils/issues",
  "keywords": [
    "msw",
    "utils"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./runtime-guards": "./dist/runtime-guards.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "msw": ">=2.11.0 <3.0.0"
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "msw": "catalog:dev",
    "oxfmt": "catalog:dev",
    "oxlint": "catalog:dev",
    "oxlint-tsgolint": "catalog:dev",
    "publint": "catalog:dev",
    "tsdown": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev"
  }
}
