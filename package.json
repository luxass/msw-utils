{
  "name": "@luxass/msw-utils",
  "version": "0.6.1",
  "description": "Utilities for working with MSW",
  "type": "module",
  "author": {
    "name": "Lucas Nørgård",
    "email": "lucasnrgaard@gmail.com",
    "url": "https://luxass.dev"
  },
  "packageManager": "pnpm@10.32.1",
  "license": "MIT",
  "homepage": "https://github.com/luxass/msw-utils#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luxass/msw-utils.git"
  },
  "bugs": "https://github.com/luxass/msw-utils/issues",
  "keywords": [
    "msw",
    "utils"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./runtime-guards": "./dist/runtime-guards.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "msw": ">=2.11.0 <3.0.0"
  },
  "devDependencies": {
    "@luxass/eslint-config": "7.3.0",
    "@types/node": "22.18.8",
    "eslint": "10.0.3",
    "eslint-plugin-format": "2.0.1",
    "msw": "2.12.10",
    "publint": "0.3.18",
    "tsdown": "0.21.2",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "msw"
    ]
  }
}
